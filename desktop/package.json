{
  "name": "huohuo-drama-desktop",
  "version": "1.0.0",
  "description": "Huohuo Drama desktop — local SQLite runtime or remote console URL",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist": "npm run prepare:runtime && electron-builder",
    "dist:win": "npm run prepare:runtime && electron-builder --win",
    "dist:mac": "npm run prepare:runtime && electron-builder --mac",
    "dist:linux": "npm run prepare:runtime && electron-builder --linux"
  },
  "build": {
    "appId": "com.seeddrama.console",
    "productName": "火火短剧",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Huohuo-Drama-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Huohuo-Drama-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Huohuo-Drama-${version}-linux-${arch}.${ext}",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}

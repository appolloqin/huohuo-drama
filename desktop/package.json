{
  "name": "huohuo-drama-desktop",
  "version": "1.0.0",
  "description": "Huohuo Drama desktop — local SQLite runtime or remote console URL",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "smoke:modes": "node scripts/smoke-modes.mjs",
    "dist": "npm run prepare:runtime && electron-builder",
    "dist:win": "npm run prepare:runtime && electron-builder --win",
    "dist:mac": "npm run prepare:runtime && electron-builder --mac",
    "dist:linux": "npm run prepare:runtime && electron-builder --linux"
  },
  "build": {
    "appId": "com.seeddrama.console",
    "productName": "火火短剧",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "afterPack": "scripts/after-pack-icon.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "HuohuoDrama",
      "artifactName": "Huohuo-Drama-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "artifactName": "Huohuo-Drama-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "Huohuo-Drama-${version}-linux-${arch}.${ext}",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "火火短剧",
      "uninstallDisplayName": "火火短剧",
      "installerIcon": "build/icon-win-rcedit.ico",
      "uninstallerIcon": "build/icon-win-rcedit.ico",
      "installerHeaderIcon": "build/icon-win-rcedit.ico",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "35.5.1",
    "electron-builder": "25.1.8"
  }
}
